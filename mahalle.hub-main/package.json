{
  "name": "mahallehub-backend",
  "version": "1.0.0",
  "description": "MahalleHub - Hyperlocal marketplace for neighborhood services and home-cooked products in Turkey",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "seed": "tsx src/scripts/seed.ts",
    "check:db": "tsx src/scripts/check-firestore.ts",
    "test:api": "tsx src/scripts/test-api.ts"
  },
  "keywords": [
    "hyperlocal",
    "marketplace",
    "neighborhood",
    "turkey",
    "express",
    "typescript",
    "firebase"
  ],
  "author": "MahalleHub Team",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^13.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
