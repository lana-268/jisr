PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Firebase Admin Configuration (Optional if running in local hackathon mode or with Firestore Emulator)
# If provided, the backend initializes real Firebase Admin credentials
FIREBASE_PROJECT_ID=mahallehub-app
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Or point to a service account JSON file:
GOOGLE_APPLICATION_CREDENTIALS=

# Hackathon Dev Mode Settings
# When true, supports dev tokens (e.g. Bearer dev-customer-1, dev-provider-1, dev-admin-1) for easy testing
ALLOW_DEV_AUTH=true
